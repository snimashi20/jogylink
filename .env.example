POSTGRES_DB=jogylink
POSTGRES_USER=jogylink
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://jogylink:change-me@localhost:5432/jogylink

# Auth (M1)
# Required, at least 32 characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts (seconds). Default 43200 = 12 hours.
JWT_EXPIRES_IN_SECONDS=43200
# Wrong passwords in a row (per IP + username) before login is locked, and for how long.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# API server (apps/api)
PORT=3001
# Allowed web origins, comma-separated
CORS_ORIGIN=http://localhost:3000

# Seed passwords for `pnpm --filter @jogylink/db db:seed` (M1). Dev defaults are used if unset;
# they are REQUIRED when NODE_ENV=production.
SEED_OWNER_PASSWORD=
SEED_WORKER_PASSWORD=

# Pricing (M1) — retail price = wholesale * RETAIL_MARKUP
RETAIL_MARKUP=1.10

# PayHere (M6) — use sandbox credentials for development
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# SMS gateway (M8)
SMS_API_KEY=
SMS_SENDER_ID=JogyProducts

# Photo storage for return evidence (M7)
CLOUDINARY_URL=

# Courier tracking (M8)
COURIER_API_KEY=
