POSTGRES_DB=jogylink
POSTGRES_USER=jogylink
POSTGRES_PASSWORD=change-me
# The database. Either the local Docker Postgres above, or a hosted Neon
# branch (see docs/hosting.md). Ask the team lead for the shared Neon string
# and keep it in a password manager - it is a password, so it never goes in a
# commit, a PR, an issue or a chat message. This repo is public.
DATABASE_URL=postgresql://jogylink:change-me@localhost:5432/jogylink
#
# Neon only: Neon gives two hosts for one database. The pooled host carries
# "-pooler" in its name and is what the apps should use; the direct host (the
# same name without "-pooler") is what migrations should use, because a
# transaction pooler does not hold the session state a migration needs. Set
# this to the direct string and db:migrate prefers it; leave it empty for
# plain local Postgres.
DATABASE_URL_DIRECT=
# Keep sslmode=verify-full on both: Neon requires TLS, and verify-full checks
# the certificate chain and the hostname. "require" alone checks neither.

# Auth (M1)
# Required, at least 32 characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts (seconds). Default 43200 = 12 hours.
JWT_EXPIRES_IN_SECONDS=43200
# Wrong passwords in a row (per IP + username) before login is locked, and for how long.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# API server (apps/api)
PORT=3001
# Allowed web origins, comma-separated
CORS_ORIGIN=http://localhost:3000

# Seed passwords for `pnpm --filter @jogylink/db db:seed` (M1). Dev defaults are used if unset;
# they are REQUIRED when NODE_ENV=production.
SEED_OWNER_PASSWORD=
SEED_WORKER_PASSWORD=

# Pricing (M1) — retail price = wholesale * RETAIL_MARKUP
RETAIL_MARKUP=1.10

# PayHere (M6) — use sandbox credentials for development
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# SMS gateway (M8)
SMS_API_KEY=
SMS_SENDER_ID=JogyProducts

# Photo storage for return evidence (M7)
CLOUDINARY_URL=

# Courier tracking (M8)
COURIER_API_KEY=

# Web app (apps/web): where the web server finds the API. Server-side only.
API_URL=http://localhost:3001/api
