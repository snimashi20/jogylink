POSTGRES_DB=jogylink
POSTGRES_USER=jogylink
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://jogylink:change-me@localhost:5432/jogylink

# Auth (M1)
JWT_SECRET=change-me

# Seed passwords for `pnpm --filter @jogylink/db db:seed` (M1). Dev defaults are used if unset;
# they are REQUIRED when NODE_ENV=production.
SEED_OWNER_PASSWORD=
SEED_WORKER_PASSWORD=

# Pricing (M1) — retail price = wholesale * RETAIL_MARKUP
RETAIL_MARKUP=1.10

# PayHere (M6) — use sandbox credentials for development
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# SMS gateway (M8)
SMS_API_KEY=
SMS_SENDER_ID=JogyProducts

# Photo storage for return evidence (M7)
CLOUDINARY_URL=

# Courier tracking (M8)
COURIER_API_KEY=
